{
  "name": "gcworld/sessions",
  "description": "Redis-backed PHP session lifecycle and security primitives",
  "authors": [
    {
      "name": "GameCharmer",
      "email": "admin@gamecharmer.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-redis": "*",
    "ramsey/uuid": "^4.9"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "GCWorld\\Sessions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GCWorld\\Sessions\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "phpcs": "phpcs",
    "test": "phpunit",
    "check": [
      "@lint",
      "@phpstan",
      "@phpcs",
      "@test"
    ]
  },
  "license": "MIT",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
